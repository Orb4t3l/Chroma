{
  "multipart": [
    { "apply": { "model": "chroma:block/pane_post" } },
    { "when": { "north": "true" },  "apply": { "model": "chroma:block/pane_side" } },
    { "when": { "east": "true" },   "apply": { "model": "chroma:block/pane_side", "y": 90 } },
    { "when": { "south": "true" },  "apply": { "model": "chroma:block/pane_side", "y": 180 } },
    { "when": { "west": "true" },   "apply": { "model": "chroma:block/pane_side", "y": 270 } },
    { "when": { "north": "false" }, "apply": { "model": "chroma:block/pane_noside" } },
    { "when": { "east": "false" },  "apply": { "model": "chroma:block/pane_noside", "y": 90 } },
    { "when": { "south": "false" }, "apply": { "model": "chroma:block/pane_noside", "y": 180 } },
    { "when": { "west": "false" },  "apply": { "model": "chroma:block/pane_noside", "y": 270 } }
  ]
}